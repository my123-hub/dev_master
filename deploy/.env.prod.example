# ===== STK 本然家居 生产环境变量样例 =====
# 使用：复制为 deploy/.env.prod 并填入真实值，切勿提交真实密钥到仓库。
# 启动：docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env.prod up -d

# ---- 数据库（postgres 容器）----
POSTGRES_DB=stk_db
POSTGRES_USER=stk
POSTGRES_PASSWORD=请改为强密码（≥16 位，含大小写/数字/符号）

# ---- 后端 ----
# JWT 签名密钥：务必改为长随机串，例如 `openssl rand -hex 32` 的输出
JWT_SECRET=请改为长随机字符串
# 允许跨域来源（生产同域可填官网域名；留空则仅同源）
CORS_ORIGINS=https://www.yourdomain.com

# ---- 初始管理员密码（可选）----
# 留空：容器首次启动随机生成强密码并打印到日志，首次登录强制修改
# 填写：直接使用该值作为 admin 初始密码
ADMIN_INITIAL_PASSWORD=

# ---- 端口映射 ----
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
ADMIN_PORT=8080

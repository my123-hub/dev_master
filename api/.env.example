# ============================================================
# STK 本然家居 api 环境变量示例（复制为 .env 后按需修改）
# 注意：.env 已被 .gitignore 排除，禁止提交真实密钥
# ============================================================

# 数据库连接串：开发默认 SQLite；生产切换 PostgreSQL
# 生产示例: DATABASE_URL=postgresql://stk:password@postgres:5432/stk_db
DATABASE_URL=sqlite:///./app.db

# JWT 密钥：生产环境必须更换为强随机值
# 生成命令: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# 跨域白名单（逗号分隔）：前台 5173 / 后台 5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# 初始超管密码（seed.py 读取；不设置则随机生成并打印）
# ADMIN_INITIAL_PASSWORD=YourStrongPassword

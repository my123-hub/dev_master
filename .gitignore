# ============================================================
# STK 本然家居 项目 .gitignore
# 按项目目录规范：api/(Python) / backend/(后台管理) / frontend/(前台官网)
# ============================================================

# ---- Python 虚拟环境（递归忽略任何级别的 venv，用户截图规范）----
venv/
.venv/
env/
ENV/

# ---- Python 缓存 ----
__pycache__/
*.py[cod]
*.py.class
.Python
pip-log.txt

# ---- Python 构建/分发 ----
build/
dist/
*.egg-info/
.eggs/

# ---- 环境变量（本地敏感配置不入仓）----
.env
.env.*
!.env.example

# ---- 本地数据库（开发 SQLite，运行期生成）----
*.db
*.sqlite3

# ---- 上传文件（运行期数据）----
uploads/

# ---- 日志 ----
*.log

# ---- Node.js 依赖与构建产物（backend/frontend 均为 Vite 工程）----
node_modules/
dist-ssr/
*.tsbuildinfo

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---- 项目内部临时产物（不入仓）----
.workbuddy/shots/
